# ============================================================
# AgentOps — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agentops:changeme@localhost:5432/agentops
DATABASE_URL_SYNC=postgresql://agentops:changeme@localhost:5432/agentops

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here-generate-a-real-one
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Allowed values: development | production | test
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ingestion limits ---
MAX_EVENTS_PER_BATCH=1000
MAX_INGESTION_PAYLOAD_BYTES=10485760

# --- Rate limiting ---
RATE_LIMIT_INGESTION_PER_MINUTE=6000
RATE_LIMIT_API_PER_MINUTE=300

# --- Optional: email alerts stub ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-smtp-password
